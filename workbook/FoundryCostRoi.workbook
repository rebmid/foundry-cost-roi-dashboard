{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## AI Cost & ROI (Application Insights variant)\nThis is the App Insights customMetrics variant with an inline rate card you maintain in each query. For the auto-refreshed rate card (PRICING_CL), consistent month-to-date KPIs, and a PRICE MISSING data-quality tile, prefer the Log Analytics workbooks (FoundryCostAnalysis-LogAnalytics and FoundryCostRoi-LogAnalytics). Unknown deployments are priced as **unmapped** ($0), never guessed as a model. The ROI inputs are **examples**: replace hoursSaved and loadedRate with your own. For billed dollars, reconcile against a FOCUS export (see the README)."
      },
      "name": "title"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "p-timerange",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time range",
            "type": 4,
            "value": { "durationMs": 2592000000 },
            "typeSettings": {
              "selectableValues": [
                { "durationMs": 604800000 },
                { "durationMs": 2592000000 },
                { "durationMs": 7776000000 }
              ]
            }
          },
          {
            "id": "p-appinsights",
            "version": "KqlParameterItem/1.0",
            "name": "AppInsights",
            "label": "Application Insights",
            "type": 5,
            "isRequired": true,
            "typeSettings": {
              "resourceTypeFilter": { "microsoft.insights/components": true },
              "additionalResourceOptions": []
            }
          }
        ],
        "style": "pills",
        "queryType": 0
      },
      "name": "parameters"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let rates=datatable(family:string,inK:real,outK:real)[\"gpt-5.x\",0.00125,0.010,\"gpt-4o\",0.0025,0.010,\"gpt-4o-mini\",0.00015,0.0006,\"o-series\",0.0011,0.0044];\nlet base=customMetrics\n| where name in (\"Prompt Tokens\",\"Completion Tokens\",\"Cached Tokens\")\n| extend dep=tostring(customDimensions.ModelDeploymentName)\n| extend family=case(dep has \"gpt-4o-mini\",\"gpt-4o-mini\",dep has \"gpt-4o\",\"gpt-4o\",dep has \"gpt-5\",\"gpt-5.x\",dep has_any(\"o1\",\"o3\",\"o4\"),\"o-series\",\"unmapped\")\n| summarize inTok=sumif(valueSum,name==\"Prompt Tokens\"),outTok=sumif(valueSum,name==\"Completion Tokens\") by family,bin(timestamp,1d)\n| lookup kind=leftouter rates on family\n| extend costUsd=(inTok/1000.0*coalesce(inK,0.0))+(outTok/1000.0*coalesce(outK,0.0));\nlet mtd=toscalar(base | where timestamp>=startofmonth(now()) | summarize sum(costUsd));\nlet tot=toscalar(base | where timestamp>=startofmonth(now()) | summarize sum(costUsd));\nlet tok=toscalar(base | where timestamp>=startofmonth(now()) | summarize sum(inTok+outTok));\nlet promptTok=toscalar(customMetrics | where name==\"Prompt Tokens\" | where timestamp>=startofmonth(now()) | summarize sum(valueSum));\nlet cacheTok=toscalar(customMetrics | where name==\"Cached Tokens\" | where timestamp>=startofmonth(now()) | summarize sum(valueSum));\nlet dNow=toreal(datetime_part(\"day\",now()));\nlet dEnd=toreal(datetime_part(\"day\",endofmonth(now())));\nprint ord=1,Metric=\"Month-to-date cost\",Value=strcat(\"$\",tostring(round(mtd,0)))\n| union (print ord=2,Metric=\"Forecast (end of month)\",Value=strcat(\"$\",tostring(round(mtd/dNow*dEnd,0))))\n| union (print ord=3,Metric=\"Cost per 1K tokens\",Value=strcat(\"$\",tostring(round(tot/(tok/1000.0),4))))\n| union (print ord=4,Metric=\"Prompt cache hit rate\",Value=iff(isnull(promptTok) or promptTok==0,\"n/a\",strcat(tostring(round(100.0*cacheTok/promptTok,1)),\"%\")))\n| order by ord asc\n| project Metric,Value",
        "size": 3,
        "title": "Headline",
        "timeContext": { "durationMs": 3024000000 },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [ "{AppInsights}" ],
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": { "columnMatch": "Metric", "formatter": 1 },
          "leftContent": { "columnMatch": "Value", "formatter": 1 },
          "showBorder": true
        }
      },
      "name": "kpi-strip"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let rates=datatable(family:string,inK:real,outK:real)[\"gpt-5.x\",0.00125,0.010,\"gpt-4o\",0.0025,0.010,\"gpt-4o-mini\",0.00015,0.0006,\"o-series\",0.0011,0.0044];\nlet base=customMetrics\n| where name in (\"Prompt Tokens\",\"Completion Tokens\")\n| extend dep=tostring(customDimensions.ModelDeploymentName)\n| extend family=case(dep has \"gpt-4o-mini\",\"gpt-4o-mini\",dep has \"gpt-4o\",\"gpt-4o\",dep has \"gpt-5\",\"gpt-5.x\",dep has_any(\"o1\",\"o3\",\"o4\"),\"o-series\",\"unmapped\")\n| summarize inTok=sumif(valueSum,name==\"Prompt Tokens\"),outTok=sumif(valueSum,name==\"Completion Tokens\") by family,bin(timestamp,1d)\n| lookup kind=leftouter rates on family\n| extend costUsd=(inTok/1000.0*coalesce(inK,0.0))+(outTok/1000.0*coalesce(outK,0.0));\nbase\n| make-series DailyCostUsd=sum(costUsd) default=0 on timestamp from startofday(ago(30d)) to startofday(now()) step 1d\n| extend (flag,score,baseline)=series_decompose_anomalies(DailyCostUsd,1.5)\n| mv-expand timestamp to typeof(datetime),DailyCostUsd to typeof(real),flag to typeof(long)\n| project timestamp,DailyCostUsd=round(DailyCostUsd,2),Anomaly=iff(flag!=0,round(DailyCostUsd,2),real(null))",
        "size": 0,
        "title": "Daily AI spend (USD) with anomaly",
        "timeContext": { "durationMs": 3024000000 },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [ "{AppInsights}" ],
        "visualization": "timechart"
      },
      "customWidth": "60",
      "name": "daily-spend"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let rates=datatable(family:string,inK:real,outK:real)[\"gpt-5.x\",0.00125,0.010,\"gpt-4o\",0.0025,0.010,\"gpt-4o-mini\",0.00015,0.0006,\"o-series\",0.0011,0.0044];\ncustomMetrics\n| where name in (\"Prompt Tokens\",\"Completion Tokens\")\n| where timestamp>=startofmonth(now())\n| extend dep=tostring(customDimensions.ModelDeploymentName)\n| extend family=case(dep has \"gpt-4o-mini\",\"gpt-4o-mini\",dep has \"gpt-4o\",\"gpt-4o\",dep has \"gpt-5\",\"gpt-5.x\",dep has_any(\"o1\",\"o3\",\"o4\"),\"o-series\",\"unmapped\")\n| summarize inTok=sumif(valueSum,name==\"Prompt Tokens\"),outTok=sumif(valueSum,name==\"Completion Tokens\") by family\n| lookup kind=leftouter rates on family\n| extend CostUsd=round((inTok/1000.0*coalesce(inK,0.0))+(outTok/1000.0*coalesce(outK,0.0)),2)\n| project family,CostUsd\n| order by CostUsd desc",
        "size": 0,
        "title": "Spend by model (MTD)",
        "timeContext": { "durationMs": 3024000000 },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [ "{AppInsights}" ],
        "visualization": "barchart"
      },
      "customWidth": "40",
      "name": "spend-by-model"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "customMetrics\n| where name in (\"Prompt Tokens\",\"Completion Tokens\",\"Cached Tokens\")\n| extend TokenType=case(name==\"Prompt Tokens\",\"Input\",name==\"Completion Tokens\",\"Output\",\"Cached\")\n| summarize Tokens=sum(valueSum) by TokenType,bin(timestamp,1d)\n| evaluate pivot(TokenType,sum(Tokens))\n| order by timestamp asc",
        "size": 0,
        "title": "Token volume by type (Input / Output / Cached)",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [ "{AppInsights}" ],
        "visualization": "barchart",
        "chartSettings": { "createOtherGroup": null }
      },
      "customWidth": "60",
      "name": "token-volume"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let hoursSaved=1240.0;\nlet loadedRate=74.0;\nlet rates=datatable(family:string,inK:real,outK:real)[\"gpt-5.x\",0.00125,0.010,\"gpt-4o\",0.0025,0.010,\"gpt-4o-mini\",0.00015,0.0006,\"o-series\",0.0011,0.0044];\nlet base=customMetrics\n| where name in (\"Prompt Tokens\",\"Completion Tokens\")\n| where timestamp>=startofmonth(now())\n| extend dep=tostring(customDimensions.ModelDeploymentName)\n| extend family=case(dep has \"gpt-4o-mini\",\"gpt-4o-mini\",dep has \"gpt-4o\",\"gpt-4o\",dep has \"gpt-5\",\"gpt-5.x\",dep has_any(\"o1\",\"o3\",\"o4\"),\"o-series\",\"unmapped\")\n| summarize inTok=sumif(valueSum,name==\"Prompt Tokens\"),outTok=sumif(valueSum,name==\"Completion Tokens\") by family\n| lookup kind=leftouter rates on family\n| extend costUsd=(inTok/1000.0*coalesce(inK,0.0))+(outTok/1000.0*coalesce(outK,0.0));\nlet valueOfTime=hoursSaved*loadedRate;\nlet agentCost=toscalar(base | summarize sum(costUsd));\nprint ord=1,Metric=\"Net ROI\",Value=iff(agentCost<1.0,\"n/a (spend < $1, illustrative)\",strcat(tostring(round(100.0*(valueOfTime-agentCost)/agentCost,0)),\"%\"))\n| union (print ord=2,Metric=\"Hours saved / period\",Value=tostring(hoursSaved))\n| union (print ord=3,Metric=\"Value of time saved\",Value=strcat(\"$\",tostring(round(valueOfTime,0))))\n| union (print ord=4,Metric=\"Agent run cost\",Value=strcat(\"$\",tostring(round(agentCost,0))))\n| union (print ord=5,Metric=\"Payback (share of period)\",Value=iff(valueOfTime<=0,\"n/a\",tostring(round(agentCost/valueOfTime,2))))\n| order by ord asc\n| project Metric,Value",
        "size": 0,
        "title": "Business value / ROI (example inputs; edit hoursSaved and loadedRate)",
        "timeContext": { "durationMs": 3024000000 },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [ "{AppInsights}" ],
        "visualization": "table"
      },
      "customWidth": "40",
      "name": "roi"
    }
  ],
  "fallbackResourceIds": [],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
