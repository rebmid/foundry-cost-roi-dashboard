{
    "version":  "Notebook/1.0",
    "items":  [
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "# AI Cost and Chargeback (Foundry via APIM)\nA reusable drop-in for any Azure-Samples **finops-framework** deployment. Tokens from `ApiManagementGatewayLlmLog` are priced from the `PRICING_CL` rates table (refreshed from the Azure Retail Prices API) and attributed to APIM subscriptions (teams). Use the **Subscription** picker to scope every tile. Costs shown are Azure list price."
                                  },
                      "name":  "header"
                  },
                  {
                      "type":  9,
                      "content":  {
                                      "version":  "KqlParameterItem/1.0",
                                      "parameters":  [
                                                         {
                                                             "id":  "tr",
                                                             "version":  "KqlParameterItem/1.0",
                                                             "name":  "TimeRange",
                                                             "type":  4,
                                                             "isRequired":  true,
                                                             "typeSettings":  {
                                                                                  "selectableValues":  [
                                                                                                           {
                                                                                                               "durationMs":  3600000
                                                                                                           },
                                                                                                           {
                                                                                                               "durationMs":  14400000
                                                                                                           },
                                                                                                           {
                                                                                                               "durationMs":  86400000
                                                                                                           },
                                                                                                           {
                                                                                                               "durationMs":  604800000
                                                                                                           },
                                                                                                           {
                                                                                                               "durationMs":  2592000000
                                                                                                           }
                                                                                                       ]
                                                                              },
                                                             "value":  {
                                                                           "durationMs":  86400000
                                                                       }
                                                         },
                                                         {
                                                             "id":  "sub",
                                                             "version":  "KqlParameterItem/1.0",
                                                             "name":  "Subscription",
                                                             "label":  "Subscription",
                                                             "type":  2,
                                                             "isRequired":  true,
                                                             "multiSelect":  true,
                                                             "quote":  "\u0027",
                                                             "delimiter":  ",",
                                                             "query":  "ApiManagementGatewayLogs | where isnotempty(ApimSubscriptionId) | distinct ApimSubscriptionId | order by ApimSubscriptionId asc",
                                                             "typeSettings":  {
                                                                                  "additionalResourceOptions":  [
                                                                                                                    "value::all"
                                                                                                                ],
                                                                                  "showDefault":  false
                                                                              },
                                                             "defaultValue":  "value::all",
                                                             "queryType":  0,
                                                             "resourceType":  "microsoft.operationalinsights/workspaces"
                                                         }
                                                     ],
                                      "style":  "pills",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces"
                                  },
                      "name":  "parameters"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Summary for the selected time range: {TimeRange:label}\nThese four tiles follow the **Time range** picker above (default is the last 24 hours), not the calendar month. For month-to-date totals, see the **Month to date** section just below."
                                  },
                      "name":  "h-kpi"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;let P = ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0;\r\nlet c = toscalar(P | summarize sum(Cost));\r\nlet t = toscalar(P | summarize sum(TotalTokens));\r\nlet n = toscalar(P | summarize count());\r\nunion\r\n (print Name=\u0027Cost (USD)\u0027, Value=tostring(round(c, 2)), Order=1),\r\n (print Name=\u0027Total tokens\u0027, Value=tostring(t), Order=2),\r\n (print Name=\u0027Calls\u0027, Value=tostring(n), Order=3),\r\n (print Name=\u0027Cost / 1K tokens (USD)\u0027, Value=tostring(iff(t \u003e 0, round(c / (todouble(t) / 1000.0), 4), 0.0)), Order=4)\r\n| order by Order asc\r\n| project Name, Value",
                                      "size":  4,
                                      "timeContextFromParameter":  "TimeRange",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "tiles",
                                      "tileSettings":  {
                                                           "titleContent":  {
                                                                                "columnMatch":  "Name",
                                                                                "formatter":  1
                                                                            },
                                                           "leftContent":  {
                                                                               "columnMatch":  "Value",
                                                                               "formatter":  1
                                                                           },
                                                           "showBorder":  true
                                                       }
                                  },
                      "name":  "kpi"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Month to date\nFixed window from the first of the current month to now. The **Time range** picker above does not apply to these three tiles; the **Subscription** picker still does. Projected month-end is a run-rate: (spend so far / days elapsed) x days in the month."
                                  },
                      "name":  "h-mtd"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;let P = ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| where TimeGenerated \u003e= startofmonth(now())\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0;\r\nlet mtd = toscalar(P | summarize sum(Cost));\r\nlet elapsed = (now() - startofmonth(now())) / 1d;\r\nlet inMonth = (datetime_add(\u0027month\u0027, 1, startofmonth(now())) - startofmonth(now())) / 1d;\r\nlet projected = iff(elapsed \u003e 0, mtd / elapsed * inMonth, 0.0);\r\nunion\r\n (print Name=\u0027Spend month-to-date (USD)\u0027, Value=tostring(round(mtd, 2)), Order=1),\r\n (print Name=\u0027Projected month-end (USD)\u0027, Value=tostring(round(projected, 2)), Order=2),\r\n (print Name=\u0027Avg spend / day (USD)\u0027, Value=tostring(iff(elapsed \u003e 0, round(mtd / elapsed, 2), 0.0)), Order=3)\r\n| order by Order asc\r\n| project Name, Value",
                                      "size":  4,
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "tiles",
                                      "tileSettings":  {
                                                           "titleContent":  {
                                                                                "columnMatch":  "Name",
                                                                                "formatter":  1
                                                                            },
                                                           "leftContent":  {
                                                                               "columnMatch":  "Value",
                                                                               "formatter":  1
                                                                           },
                                                           "showBorder":  true
                                                       }
                                  },
                      "name":  "kpi-mtd"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Spend this month: per day and cumulative\nEach bar is one day of list-price spend; the area chart is the running total (burn-up) toward the projected month-end above. Fixed to the current calendar month, scoped by the **Subscription** picker."
                                  },
                      "name":  "h-mtd-charts"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| where TimeGenerated \u003e= startofmonth(now())\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| summarize Cost = round(sum(Cost), 4) by DayBin = bin(TimeGenerated, 1d)\n| order by DayBin asc\n| project Day = format_datetime(DayBin, \u0027yyyy-MM-dd\u0027), [\u0027Cost (USD)\u0027] = Cost",
                                      "size":  2,
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "barchart"
                                  },
                      "name":  "mtd-daily",
                      "customWidth":  "50"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| where TimeGenerated \u003e= startofmonth(now())\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| summarize Daily = sum(Cost) by bin(TimeGenerated, 1d)\n| order by TimeGenerated asc\n| serialize [\u0027Cumulative spend (USD)\u0027] = round(row_cumsum(Daily), 4)\n| project TimeGenerated, [\u0027Cumulative spend (USD)\u0027]",
                                      "size":  2,
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "areachart"
                                  },
                      "name":  "mtd-cumulative",
                      "customWidth":  "50"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Live token volume (platform metrics, ~1 min)\nSourced from `AzureMetrics` (platform metrics routed to this workspace). Faster than the log tiles below, but model-level only and **not filtered by the Subscription picker** (platform metrics carry no subscription dimension). For the true 1-minute view, open **Metrics** on the Foundry resource."
                                  },
                      "name":  "h-live"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "AzureMetrics\r\n| where ResourceProvider =~ \u0027MICROSOFT.COGNITIVESERVICES\u0027\r\n| where MetricName in (\u0027TotalTokens\u0027,\u0027InputTokens\u0027,\u0027OutputTokens\u0027)\r\n| summarize Tokens = sum(Total) by bin(TimeGenerated, 1m), MetricName\r\n| order by TimeGenerated asc",
                                      "size":  2,
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "timechart"
                                  },
                      "name":  "live-metrics"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Where the money goes ({TimeRange:label})"
                                  },
                      "name":  "h-breakdown"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend PriceMissing = isnull(InputTokensPrice)\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| summarize [\u0027Cost (USD)\u0027] = round(sum(Cost), 4) by DeploymentName\n| order by [\u0027Cost (USD)\u0027] desc",
                                      "size":  1,
                                      "timeContextFromParameter":  "TimeRange",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "barchart"
                                  },
                      "name":  "spend-by-model",
                      "customWidth":  "50"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend PriceMissing = isnull(InputTokensPrice)\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| summarize [\u0027Cost (USD)\u0027] = round(sum(Cost), 4) by Team\n| order by [\u0027Cost (USD)\u0027] desc",
                                      "size":  1,
                                      "timeContextFromParameter":  "TimeRange",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "barchart"
                                  },
                      "name":  "spend-by-team",
                      "customWidth":  "50"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Spend over time by model ({TimeRange:label})\nHourly bins within the selected **Time range**. Use this to drill into a spike; use the **Month to date** section above for the monthly money view."
                                  },
                      "name":  "h-trend"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend PriceMissing = isnull(InputTokensPrice)\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| summarize [\u0027Cost (USD)\u0027] = round(sum(Cost), 4) by bin(TimeGenerated, 1h), DeploymentName",
                                      "size":  2,
                                      "timeContextFromParameter":  "TimeRange",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "timechart"
                                  },
                      "name":  "trend"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Spend anomaly detection (actual vs expected, last 24h)"
                                  },
                      "name":  "h-anomaly"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0\r\n| make-series Spend = sum(Cost) default=0 on TimeGenerated from ago(1d) to now() step 30m\r\n| extend (anomalies, score, baseline) = series_decompose_anomalies(Spend, 1.5)\r\n| mv-expand TimeGenerated to typeof(datetime), Spend to typeof(double), baseline to typeof(double)\r\n| project TimeGenerated, [\u0027Actual spend (USD)\u0027] = Spend, [\u0027Expected (baseline)\u0027] = baseline",
                                      "size":  2,
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "timechart"
                                  },
                      "name":  "anomaly"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Budget vs actual (per team, {TimeRange:label})\nSpend in the selected **Time range** vs each team\u0027s quota. Set the picker to **Last 30 days** for a monthly budget view."
                                  },
                      "name":  "h-budget"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend PriceMissing = isnull(InputTokensPrice)\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| summarize Cost = sum(Cost) by Team\r\n| join kind=inner (SUBSCRIPTION_QUOTA_CL | summarize arg_max(TimeGenerated, *) by Subscription | project Team = Subscription, CostQuota) on Team\r\n| extend PctUsed = round(100.0 * Cost / CostQuota, 1)\r\n| extend Status = case(PctUsed \u003e= 100, \u0027OVER BUDGET\u0027, PctUsed \u003e= 80, \u0027Warning\u0027, \u0027OK\u0027)\r\n| project Team, [\u0027Spend (USD)\u0027] = round(Cost, 4), [\u0027Quota (USD)\u0027] = CostQuota, [\u0027% used\u0027] = PctUsed, Status\r\n| order by [\u0027% used\u0027] desc",
                                      "size":  2,
                                      "timeContextFromParameter":  "TimeRange",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "table"
                                  },
                      "name":  "budget"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Data quality: deployments with no rate-card entry (PRICE MISSING) - {TimeRange:label}\nThese calls are counted but priced at 0 because no PRICING_CL row matches the deployment name. Empty table = every model is priced."
                                  },
                      "name":  "h-unmapped"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend PriceMissing = isnull(InputTokensPrice)\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| where PriceMissing\n| summarize Calls = count(), [\u0027Unpriced tokens\u0027] = sum(TotalTokens) by DeploymentName\n| order by Calls desc",
                                      "size":  1,
                                      "timeContextFromParameter":  "TimeRange",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "table"
                                  },
                      "name":  "unmapped"
                  },
                  {
                      "type":  1,
                      "content":  {
                                      "json":  "## Token split and top consumers ({TimeRange:label})"
                                  },
                      "name":  "h-detail"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend PriceMissing = isnull(InputTokensPrice)\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| summarize [\u0027Prompt tokens\u0027] = sum(PromptTokens), [\u0027Completion tokens\u0027] = sum(CompletionTokens) by DeploymentName\n| order by [\u0027Prompt tokens\u0027] desc",
                                      "size":  1,
                                      "timeContextFromParameter":  "TimeRange",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "barchart"
                                  },
                      "name":  "token-split",
                      "customWidth":  "40"
                  },
                  {
                      "type":  3,
                      "content":  {
                                      "version":  "KqlItem/1.0",
                                      "query":  "let rateCard = PRICING_CL | summarize arg_max(TimeGenerated, *) by Model | project Model, InputTokensPrice, OutputTokensPrice;ApiManagementGatewayLlmLog\r\n| where DeploymentName != \u0027\u0027\r\n| join kind=leftouter (ApiManagementGatewayLogs | project CorrelationId, ApimSubscriptionId) on CorrelationId\r\n| extend Team = coalesce(ApimSubscriptionId, \u0027unknown\u0027)\r\n| where \u0027*\u0027 in ({Subscription}) or Team in ({Subscription})\r\n| join kind=leftouter rateCard on $left.DeploymentName == $right.Model\r\n| extend PriceMissing = isnull(InputTokensPrice)\r\n| extend InputTokensPrice = coalesce(InputTokensPrice, 0.0), OutputTokensPrice = coalesce(OutputTokensPrice, 0.0)\r\n| extend Cost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000.0| summarize Calls = count(), [\u0027Input tokens\u0027] = sum(PromptTokens), [\u0027Output tokens\u0027] = sum(CompletionTokens), [\u0027Cost (USD)\u0027] = round(sum(Cost), 4) by Team, DeploymentName\n| order by [\u0027Cost (USD)\u0027] desc",
                                      "size":  1,
                                      "timeContextFromParameter":  "TimeRange",
                                      "queryType":  0,
                                      "resourceType":  "microsoft.operationalinsights/workspaces",
                                      "visualization":  "table"
                                  },
                      "name":  "top-consumers",
                      "customWidth":  "60"
                  },
