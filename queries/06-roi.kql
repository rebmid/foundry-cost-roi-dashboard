// 06 - Business value / ROI
// Compares the agent's run cost (from tokens x rate card) against the business value
// it creates (hours saved x loaded hourly rate). Edit the two inputs at the top.
// Returns rows (Metric, Value) for a "tiles" or table visual.

let hoursSaved = 1240.0;    // <-- business input: hours saved this period
let loadedRate = 74.0;      // <-- business input: fully loaded $/hour
let rates = datatable(family:string, inK:real, outK:real) [
    "gpt-5.x",     0.00125, 0.010,
    "gpt-4o",      0.0025,  0.010,
    "gpt-4o-mini", 0.00015, 0.0006,
    "o-series",    0.0011,  0.0044
];
let base = customMetrics
    | where name in ("Prompt Tokens", "Completion Tokens")
    | where timestamp >= startofmonth(now())
    | extend dep = tostring(customDimensions.ModelDeploymentName)
    | extend family = case(
        dep has "gpt-4o-mini", "gpt-4o-mini",
        dep has "gpt-4o",      "gpt-4o",
        dep has "gpt-5",       "gpt-5.x",
        dep has_any ("o1", "o3", "o4"), "o-series",
        "unmapped")
    | summarize inTok = sumif(valueSum, name == "Prompt Tokens"),
                outTok = sumif(valueSum, name == "Completion Tokens")
             by family
    | lookup kind=leftouter rates on family
    | extend costUsd = (inTok / 1000.0 * coalesce(inK, 0.0)) + (outTok / 1000.0 * coalesce(outK, 0.0));
let valueOfTime = hoursSaved * loadedRate;
let agentCost = toscalar(base | summarize sum(costUsd));
print ord = 1, Metric = "Net ROI", Value = strcat(tostring(round(100.0 * (valueOfTime - agentCost) / max_of(agentCost, 1.0), 0)), "%")
| union (print ord = 2, Metric = "Hours saved / period", Value = tostring(hoursSaved))
| union (print ord = 3, Metric = "Value of time saved", Value = strcat("$", tostring(round(valueOfTime, 0))))
| union (print ord = 4, Metric = "Agent run cost", Value = strcat("$", tostring(round(agentCost, 0))))
| union (print ord = 5, Metric = "Payback (share of period)", Value = iff(valueOfTime <= 0, "n/a", tostring(round(agentCost / valueOfTime, 2))))
| order by ord asc
| project Metric, Value
